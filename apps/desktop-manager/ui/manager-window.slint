import { Button, LineEdit, VerticalBox } from "std-widgets.slint";

component ManagementBadge inherits Rectangle {
    in property <string> label;

    border-radius: self.height / 2;
    background: #eaf2ee;
    height: 30px;
    width: status-label.preferred-width + 24px;

    status-label := Text {
        color: #35634c;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        text: root.label;
        vertical-alignment: center;
    }
}

component ApplicationRow inherits Rectangle {
    in property <string> detail;
    in property <string> application-name;
    in property <string> management-state;

    background: #ffffff;
    border-color: #dce3df;
    border-radius: 12px;
    border-width: 1px;
    height: 82px;

    HorizontalLayout {
        alignment: start;
        padding: 16px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                color: #17231d;
                font-size: 16px;
                font-weight: 600;
                text: root.application-name;
            }

            Text {
                color: #637169;
                font-size: 13px;
                overflow: elide;
                text: root.detail;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        ManagementBadge {
            label: root.management-state;
        }
    }
}

component ResourceLocation inherits Rectangle {
    in property <string> label;
    in property <string> value;

    background: #ffffff;
    border-color: #dce3df;
    border-radius: 10px;
    border-width: 1px;
    height: 54px;

    HorizontalLayout {
        alignment: center;
        padding-bottom: 10px;
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        spacing: 12px;

        Text {
            color: #637169;
            font-size: 13px;
            font-weight: 600;
            text: root.label;
            width: 124px;
        }

        LineEdit {
            font-size: 13px;
            horizontal-stretch: 1;
            read-only: true;
            text: root.value;
        }
    }
}

export component ManagerWindow inherits Window {
    title: "Job Boardwalk";
    preferred-width: 760px;
    preferred-height: 560px;
    min-width: 640px;
    min-height: 500px;
    background: #f4f7f5;

    in property <string> dashboard-url;
    in property <string> log-path;
    in-out property <string> workspace-state: "Stopped";
    in-out property <string> browser-state: "Stopped";
    in-out property <string> status-detail: "Start Job Boardwalk to make the local workspace available.";
    in-out property <string> browser-detail: "Chrome or Edge will be checked when services start.";
    in-out property <bool> can-start: true;
    in-out property <bool> can-stop: false;

    callback start-requested();
    callback stop-requested();

    VerticalBox {
        padding: 30px;
        spacing: 20px;

        VerticalLayout {
            spacing: 6px;

            Text {
                color: #17231d;
                font-size: 28px;
                font-weight: 700;
                text: "Job Boardwalk";
            }

            Text {
                color: #637169;
                font-size: 14px;
                text: root.status-detail;
            }
        }

        VerticalLayout {
            spacing: 10px;

            ApplicationRow {
                application-name: "Local workspace";
                detail: "Workspace Service and Dashboard";
                management-state: root.workspace-state;
            }

            ApplicationRow {
                application-name: "Browser Session";
                detail: root.browser-detail;
                management-state: root.browser-state;
            }
        }

        VerticalLayout {
            spacing: 8px;

            ResourceLocation {
                label: "Dashboard address";
                value: root.dashboard-url;
            }

            ResourceLocation {
                label: "Service log path";
                value: root.log-path;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Rectangle {
            background: #e8eeea;
            height: 1px;
        }

        HorizontalLayout {
            alignment: end;
            spacing: 10px;

            Button {
                text: "Stop";
                enabled: root.can-stop;
                clicked => { root.stop-requested(); }
            }

            Button {
                text: "Start";
                enabled: root.can-start;
                clicked => { root.start-requested(); }
            }
        }
    }
}
