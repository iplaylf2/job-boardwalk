import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

component ManagementBadge inherits Rectangle {
    in property <string> label;

    border-radius: self.height / 2;
    background: #eaf2ee;
    height: 30px;
    width: status-label.preferred-width + 24px;

    status-label := Text {
        color: #35634c;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        text: root.label;
        vertical-alignment: center;
    }
}

component ApplicationRow inherits Rectangle {
    in property <string> detail;
    in property <string> application-name;
    in property <string> management-state;

    background: #ffffff;
    border-color: #dce3df;
    border-radius: 12px;
    border-width: 1px;
    height: 82px;

    HorizontalLayout {
        alignment: start;
        padding: 16px;
        spacing: 14px;

        VerticalLayout {
            alignment: center;
            spacing: 4px;

            Text {
                color: #17231d;
                font-size: 16px;
                font-weight: 600;
                text: root.application-name;
            }

            Text {
                color: #637169;
                font-size: 13px;
                overflow: elide;
                text: root.detail;
            }
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        ManagementBadge {
            label: root.management-state;
        }
    }
}

export component ManagerWindow inherits Window {
    title: "Job Boardwalk";
    preferred-width: 760px;
    preferred-height: 560px;
    min-width: 640px;
    min-height: 500px;
    background: #f4f7f5;

    in property <string> dashboard-url: "http://127.0.0.1:54311";
    in-out property <string> runtime-state: "Stopped";
    in-out property <string> browser-state: "Not running";
    in-out property <string> status-detail: "Start Job Boardwalk to make the local workspace available.";
    in-out property <string> browser-detail: "A system browser is checked at startup.";
    in-out property <bool> can-start: true;
    in-out property <bool> can-stop: false;
    in-out property <bool> dashboard-available: false;
    in-out property <bool> logs-available: false;

    callback start-requested();
    callback stop-requested();
    callback open-log-requested();

    VerticalBox {
        padding: 30px;
        spacing: 20px;

        VerticalLayout {
            spacing: 6px;

            Text {
                color: #17231d;
                font-size: 28px;
                font-weight: 700;
                text: "Job Boardwalk";
            }

            Text {
                color: #637169;
                font-size: 14px;
                text: root.status-detail;
            }
        }

        VerticalLayout {
            spacing: 10px;

            ApplicationRow {
                application-name: "Local workspace";
                detail: "Workspace Service and Dashboard Host";
                management-state: root.runtime-state;
            }

            ApplicationRow {
                application-name: "Browser Session";
                detail: root.browser-detail;
                management-state: root.browser-state;
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        Rectangle {
            background: #e8eeea;
            height: 1px;
        }

        HorizontalBox {
            alignment: end;
            spacing: 10px;

            Button {
                text: "Open Logs";
                enabled: root.logs-available;
                clicked => { root.open-log-requested(); }
            }

            Rectangle { horizontal-stretch: 1; }

            Button {
                text: "Stop";
                enabled: root.can-stop;
                clicked => { root.stop-requested(); }
            }

            Button {
                text: "Start";
                enabled: root.can-start;
                clicked => { root.start-requested(); }
            }

            Button {
                text: "Open Dashboard";
                enabled: root.dashboard-available;
                clicked => { Platform.open-url(root.dashboard-url); }
            }
        }
    }
}
