import { LineEdit } from "std-widgets.slint";

component PrimaryAction inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> stop-action: false;
    callback clicked();

    background: !root.enabled ? #dfe5e2 :
        root.stop-action ? (action-area.has-hover ? #eef2f0 : #ffffff) :
        (action-area.has-hover ? #167d55 : #1d9a67);
    border-color: root.stop-action ? #ced8d3 : #00000000;
    border-radius: 10px;
    border-width: 1px;
    height: 46px;
    width: 168px;

    Text {
        color: !root.enabled ? #929d98 : root.stop-action ? #33463d : #ffffff;
        font-size: 13px;
        font-weight: 700;
        horizontal-alignment: center;
        text: root.label;
        vertical-alignment: center;
    }

    action-area := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component SecondaryAction inherits Rectangle {
    in property <string> label;
    callback clicked();

    background: action-area.has-hover ? #eef2f0 : #ffffff;
    border-color: #ced8d3;
    border-radius: 10px;
    border-width: 1px;
    height: 46px;
    width: 126px;

    Text {
        color: #33463d;
        font-size: 12px;
        font-weight: 650;
        horizontal-alignment: center;
        text: root.label;
        vertical-alignment: center;
    }

    action-area := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SectionLabel inherits Text {
    color: #84908a;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.7px;
}

component SettingsField inherits VerticalLayout {
    in property <string> label;
    in-out property <string> value;
    in property <string> hint;

    spacing: 5px;

    Text {
        color: #293b32;
        font-size: 11px;
        font-weight: 650;
        text: root.label;
    }

    LineEdit {
        font-size: 12px;
        text <=> root.value;
    }

    if root.hint != "": Text {
        color: #7b8781;
        font-size: 10px;
        text: root.hint;
        wrap: word-wrap;
    }
}

component ServiceState inherits HorizontalLayout {
    in property <string> service-name;
    in property <string> state;
    private property <bool> is-positive: root.state == "Running";
    private property <bool> is-working: root.state == "Starting" || root.state == "Stopping";
    private property <bool> is-negative: root.state == "Failed" || root.state == "Unavailable";

    alignment: start;
    cross-axis-alignment: center;
    horizontal-stretch: 1;
    spacing: 20px;

    Text {
        color: #293b32;
        font-size: 12px;
        font-weight: 650;
        text: root.service-name;
        width: 108px;
    }

    Text {
        color: root.is-positive ? #16794f :
            root.is-working ? #98610e :
            root.is-negative ? #ad4038 : #7b8781;
        font-size: 12px;
        font-weight: 600;
        text: root.state;
    }
}

component UtilityValue inherits VerticalLayout {
    in property <string> label;
    in property <string> value;

    horizontal-stretch: 1;
    spacing: 5px;

    Text {
        color: #84908a;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text: root.label;
    }

    LineEdit {
        font-size: 11px;
        horizontal-stretch: 1;
        read-only: true;
        text: root.value;
    }
}

export component ManagerWindow inherits Window {
    title: "Job Boardwalk";
    preferred-width: 720px;
    preferred-height: 540px;
    min-width: 720px;
    min-height: 540px;
    background: #f7f9f8;

    in property <string> dashboard-url;
    in property <string> log-path;
    in-out property <string> workspace-state: "Stopped";
    in-out property <string> browser-state: "Stopped";
    in-out property <string> status-detail: "Start Job Boardwalk to make the local workspace available.";
    in-out property <string> browser-detail: "A browser installation will be detected when services start.";
    in-out property <bool> can-start: true;
    in-out property <bool> can-stop: false;
    in-out property <bool> can-configure: true;
    in-out property <bool> settings-visible: false;
    in-out property <string> workspace-port;
    in-out property <string> dashboard-port;
    in-out property <string> browser-port;
    in-out property <string> browser-executable-path;
    in-out property <string> settings-detail;
    in-out property <bool> settings-has-error: false;

    private property <bool> is-running: root.workspace-state == "Running";
    private property <bool> is-limited: root.is-running && root.browser-state == "Unavailable";
    private property <bool> is-starting: root.workspace-state == "Starting";
    private property <bool> is-stopping: root.workspace-state == "Stopping";
    private property <bool> has-error: root.workspace-state == "Failed";

    callback start-requested();
    callback stop-requested();
    callback settings-requested();
    callback settings-save-requested();
    callback settings-cancel-requested();

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            background: #ffffff;
            height: 60px;

            Text {
                color: #1a2c23;
                font-size: 14px;
                font-weight: 700;
                horizontal-alignment: center;
                text: "Job Boardwalk";
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }

            Rectangle {
                background: #e5ebe8;
                height: 1px;
                y: parent.height - 1px;
            }
        }

        if !root.settings-visible: VerticalLayout {
            padding-left: 56px;
            padding-right: 56px;
            spacing: 0px;

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                height: 202px;
                spacing: 32px;
                vertical-stretch: 0;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;

                    Rectangle { vertical-stretch: 1; }

                    Text {
                        color: root.has-error ? #ad4038 :
                            root.is-limited || root.is-starting || root.is-stopping ? #98610e :
                            root.is-running ? #1d9a67 : #66736d;
                        font-size: 11px;
                        font-weight: 700;
                        letter-spacing: 1px;
                        text: root.is-limited ? "LIMITED" :
                            root.is-running ? "READY" :
                            root.is-starting ? "STARTING" :
                            root.is-stopping ? "STOPPING" :
                            root.has-error ? "ACTION NEEDED" : "STOPPED";
                    }

                    Rectangle { height: 10px; }

                    Text {
                        color: #172a21;
                        font-size: 27px;
                        font-weight: 700;
                        text: root.is-limited ? "Job Boardwalk is partially available" :
                            root.is-running ? "Job Boardwalk is running" :
                            root.is-starting ? "Starting Job Boardwalk…" :
                            root.is-stopping ? "Stopping Job Boardwalk…" :
                            root.has-error ? "Job Boardwalk could not start" :
                            "Job Boardwalk is stopped";
                        wrap: word-wrap;
                    }

                    Rectangle { height: 8px; }

                    Text {
                        color: #748079;
                        font-size: 13px;
                        text: root.status-detail;
                        wrap: word-wrap;
                    }

                    Rectangle { height: 26px; }

                    HorizontalLayout {
                        spacing: 10px;

                        if root.can-start: PrimaryAction {
                            label: "Start";
                            enabled: root.can-start;
                            clicked => { root.start-requested(); }
                        }

                        if root.can-configure: SecondaryAction {
                            label: "Settings";
                            clicked => { root.settings-requested(); }
                        }

                        if root.can-stop: PrimaryAction {
                            label: "Stop";
                            enabled: root.can-stop;
                            stop-action: true;
                            clicked => { root.stop-requested(); }
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }

                    Rectangle { vertical-stretch: 1; }
                }

                Rectangle {
                    background: #ffffff;
                    border-color: #dfe6e2;
                    border-radius: 12px;
                    border-width: 1px;
                    height: 202px;
                    width: 236px;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 0px;

                        SectionLabel {
                            text: "SERVICE OVERVIEW";
                        }

                        Rectangle { height: 16px; }

                        ServiceState {
                            service-name: "Core services";
                            state: root.workspace-state;
                        }

                        Rectangle { height: 14px; }

                        ServiceState {
                            service-name: "Browser access";
                            state: root.browser-state;
                        }

                        Rectangle { height: 14px; }

                        Text {
                            color: root.browser-state == "Unavailable" ? #a94a43 : #7b8781;
                            font-size: 10px;
                            text: root.browser-detail;
                            wrap: word-wrap;
                        }

                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }
        }

        if root.settings-visible: VerticalLayout {
            padding-left: 56px;
            padding-right: 56px;
            padding-top: 24px;
            spacing: 0px;

            Text {
                color: #1d9a67;
                font-size: 11px;
                font-weight: 700;
                letter-spacing: 1px;
                text: "SETTINGS";
            }

            Rectangle { height: 8px; }

            Text {
                color: #172a21;
                font-size: 24px;
                font-weight: 700;
                text: "Local settings";
            }

            Rectangle { height: 6px; }

            Text {
                color: #748079;
                font-size: 12px;
                text: "Changes apply the next time Job Boardwalk starts.";
            }

            Rectangle { height: 18px; }

            SectionLabel {
                text: "SERVICE PORTS";
            }

            Rectangle { height: 8px; }

            HorizontalLayout {
                spacing: 16px;

                SettingsField {
                    horizontal-stretch: 1;
                    label: "Workspace port";
                    value <=> root.workspace-port;
                    hint: "";
                }

                SettingsField {
                    horizontal-stretch: 1;
                    label: "Dashboard port";
                    value <=> root.dashboard-port;
                    hint: "";
                }

                SettingsField {
                    horizontal-stretch: 1;
                    label: "Browser port";
                    value <=> root.browser-port;
                    hint: "";
                }
            }

            Rectangle { height: 18px; }

            SectionLabel {
                text: "BROWSER";
            }

            Rectangle { height: 8px; }

            SettingsField {
                label: "Browser executable (optional)";
                value <=> root.browser-executable-path;
                hint: "Leave blank to detect Chrome, Edge, or Chromium in common system locations.";
            }

            Rectangle { height: 8px; }

            Text {
                color: root.settings-has-error ? #a94a43 : #748079;
                font-size: 11px;
                text: root.settings-detail;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                spacing: 10px;

                PrimaryAction {
                    label: "Save settings";
                    clicked => { root.settings-save-requested(); }
                }

                SecondaryAction {
                    label: "Cancel";
                    clicked => { root.settings-cancel-requested(); }
                }

                Rectangle { horizontal-stretch: 1; }
            }

            Rectangle { height: 20px; }
        }

        if !root.settings-visible: Rectangle {
            background: #eef2f0;
            height: 88px;

            HorizontalLayout {
                padding-bottom: 12px;
                padding-left: 56px;
                padding-right: 56px;
                padding-top: 12px;
                spacing: 24px;

                UtilityValue {
                    label: "DASHBOARD";
                    value: root.dashboard-url;
                }

                UtilityValue {
                    label: "SERVICE LOG";
                    value: root.log-path;
                }
            }

            Rectangle {
                background: #dfe6e2;
                height: 1px;
            }
        }
    }
}
