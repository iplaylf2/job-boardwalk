{
  "name": "@job-boardwalk/desktop-runtime",
  "private": true,
  "description": "Runs and coordinates Job Boardwalk's directory-contained desktop services.",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build:bundle": "vite build",
    "build:sea": "node build/sea.ts",
    "lint": "oxlint --config oxlint.config.ts .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.13.0",
    "@job-boardwalk/desktop-product-layout": "workspace:*",
    "@shajara/host": "catalog:"
  },
  "devDependencies": {
    "@job-boardwalk/presets": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
