{
	admin {$JOB_BOARDWALK_CADDY_ADMIN:off}
	auto_https off
	persist_config off
}

{$JOB_BOARDWALK_DASHBOARD_ADDRESS:0.0.0.0:8080} {
	encode zstd gzip

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'none'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self'; style-src 'self'"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
	}

	handle /api/* {
		reverse_proxy {$JOB_BOARDWALK_WORKSPACE_SERVICE_ADDRESS:workspace-service:54310}
	}

	handle /health {
		respond "ok" 200
	}

	handle {
		root * {env.JOB_BOARDWALK_DASHBOARD_DIRECTORY}
		try_files {path} /index.html
		file_server
	}
}
