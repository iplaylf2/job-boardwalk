{
  "name": "job-boardwalk",
  "private": true,
  "description": "A local AI job-search secretary for delegated recruiting research.",
  "type": "module",
  "scripts": {
    "boundaries": "dependency-cruise --config .dependency-cruiser.json --output-type err-long apps internal packages",
    "changeset": "changeset",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --config oxlint.config.ts oxlint.config.ts",
    "unused": "knip"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@job-boardwalk/presets": "workspace:*",
    "@moonrepo/cli": "2.4.6",
    "@types/node": "catalog:",
    "dependency-cruiser": "^18.2.0",
    "knip": "^6.32.1",
    "oxfmt": "^0.63.0",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.21.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.7.0",
    "pnpm": ">=11.21.0"
  }
}
