{
  "name": "job-boardwalk",
  "private": true,
  "description": "A local AI job-search secretary for delegated recruiting research.",
  "type": "module",
  "scripts": {
    "boundaries": "dependency-cruise --config .dependency-cruiser.json --output-type err-long apps internal packages",
    "changeset": "changeset",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --config oxlint.config.ts oxlint.config.ts",
    "unused": "knip"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@job-boardwalk/presets": "workspace:*",
    "@moonrepo/cli": "^2.5.5",
    "@types/node": "catalog:",
    "dependency-cruiser": "^18.3.1",
    "knip": "^6.36.0",
    "oxfmt": "^0.68.0",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.4.2",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.9.0",
      "onFail": "download"
    }
  },
  "engines": {
    "pnpm": ">=12.4.2"
  }
}
