# Optional Browser Session profile path. Defaults to the operating system's user data directory.
# JOB_BOARDWALK_BROWSER_PROFILE_PATH=/path/to/browser-profile

# Optional Workspace Service database path. Defaults to the operating system's user data directory.
# JOB_BOARDWALK_WORKSPACE_DATABASE_PATH=/path/to/workspace.sqlite

# Optional Workspace Service listener for source development. Compose owns its container values.
# JOB_BOARDWALK_WORKSPACE_SERVICE_HOST=127.0.0.1
# JOB_BOARDWALK_WORKSPACE_SERVICE_PORT=54310

# Optional Workspace Service base URL for Browser Session status reports.
# JOB_BOARDWALK_WORKSPACE_SERVICE_URL=http://127.0.0.1:54310

# Optional system browser candidate for Desktop Service Host source development.
# JOB_BOARDWALK_BROWSER_EXECUTABLE_PATH=/path/to/chrome-or-edge

# Optional source-development Desktop Service Host executable for Desktop Manager.
# JOB_BOARDWALK_DESKTOP_SERVICE_HOST_EXECUTABLE=/path/to/job-boardwalk-desktop-service-host

# Required platform-native Caddy input when assembling the desktop staging tree.
# JOB_BOARDWALK_DESKTOP_CADDY_EXECUTABLE=/absolute/path/to/caddy

# Optional Compose image references. Use immutable registry digests for remote deployment.
# JOB_BOARDWALK_WORKSPACE_SERVICE_IMAGE=job-boardwalk/workspace-service:local
# JOB_BOARDWALK_DASHBOARD_IMAGE=job-boardwalk/dashboard:local
